{
  // 静态站点 dist/ + 登录门禁 Worker（worker/index.js）：所有请求先过 Worker，登录后才返回页面
  "name": "up-learn",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 中考词汇学习记录：一个 Durable Object（SQLite 存储）保存复习记录、易错本、每天的做题结果和纸质卷
  "durable_objects": { "bindings": [{ "name": "VOCAB", "class_name": "VocabStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VocabStore"] }],
  "routes": [{ "pattern": "up.yiwei.website", "custom_domain": true }],
  "workers_dev": false
}
