{
  // 静态站点 dist/ + 登录门禁 Worker（worker/index.js）：所有请求先过 Worker，登录后才返回页面
  "name": "up-learn",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "up.yiwei.website", "custom_domain": true }],
  "workers_dev": false
}
